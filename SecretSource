            local ListLayout = Instance.new("UIListLayout")
            ListLayout.Padding = UDim.new(0, 4)
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ListLayout.Parent = DropdownList

            local OptionButtons = {}
            local function refreshDisplay()
                if MultiSelect then
                    local selectedItems = {}
                    for option, enabled in pairs(SelectedOptions) do
                        if enabled then
                            table.insert(selectedItems, option)
                        end
                    end
                    DropdownDisplay.Text = Name .. ": " .. (#selectedItems > 0 and table.concat(selectedItems, ", ") or "Select item")
                else
                    local current = CurrentOption
                    DropdownDisplay.Text = Name .. ": " .. current
                end
            end

            for _, option in ipairs(Options) do
                local OptionButton = Instance.new("TextButton")
                OptionButton.Size = UDim2.new(1, 0, 0, 40)
                OptionButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                OptionButton.Text = option
                OptionButton.TextSize = 18
                OptionButton.Font = Enum.Font.GothamBold
                OptionButton.TextColor3 = Color3.fromRGB(255, 255, 255)
                OptionButton.Parent = DropdownList

                OptionButton.MouseButton1Click:Connect(function()
                    if MultiSelect then
                        SelectedOptions[option] = not SelectedOptions[option]
                        Callback(SelectedOptions)
                    else
                        CurrentOption = option
                        Callback(option)
                    end
                    refreshDisplay()
                    if not MultiSelect then
                        isExpanded = false
                        DropdownList:TweenSize(UDim2.new(1, 0, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true, function()
                            DropdownList.Visible = false
                        end)
                        DropdownContainer:TweenSize(UDim2.new(1, 0, 0, 60), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
                        TweenService:Create(DropdownButton, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Rotation = 0}):Play()
                    end
                end)

                table.insert(OptionButtons, OptionButton)
            end

            local isExpanded = false
            DropdownButton.MouseButton1Click:Connect(function()
                isExpanded = not isExpanded
                local newHeight = (#OptionButtons * 44) + 10
                if isExpanded then
                    DropdownList.Visible = true
                    DropdownList:TweenSize(UDim2.new(1, 0, 0, newHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
                    DropdownContainer:TweenSize(UDim2.new(1, 0, 0, 60 + newHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
                    TweenService:Create(DropdownButton, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Rotation = 180}):Play()
                else
                    DropdownList:TweenSize(UDim2.new(1, 0, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true, function()
                        DropdownList.Visible = false
                    end)
                    DropdownContainer:TweenSize(UDim2.new(1, 0, 0, 60), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
                    TweenService:Create(DropdownButton, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Rotation = 0}):Play()
                end
            end)

            refreshDisplay()
            return {
                Frame = DropdownContainer,
                GetValue = function()
                    if MultiSelect then
                        local selected = {}
                        for option, enabled in pairs(SelectedOptions) do
                            if enabled then
                                table.insert(selected, option)
                            end
                        end
                        return selected
                    end
                    return CurrentOption
                end,
            }
        end

        function Tab:CreateTimer(config)
            config = config or {}
            local TimerName = config.Name or "Timer"
            local Mode = config.Mode or "CountDown"
            local AutoStart = config.AutoStart or false
            local Countdown = config.Countdown or {}
            local SecondDuration = Countdown.SecondDuration or 0
            local MinuteDuration = Countdown.MinuteDuration or 0
            local HourDuration = Countdown.HourDuration or 0
            local StopStopWatch = config.StopWatch and config.StopWatch.StopStopWatch or false

            local TimerFrame = Instance.new("Frame")
            TimerFrame.Name = TimerName
            TimerFrame.Size = UDim2.new(0, 200, 0, 70)
            TimerFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            TimerFrame.Parent = self.Frame

            local TimerLabel = Instance.new("TextLabel")
            TimerLabel.Size = UDim2.new(1, 0, 0, 35)
            TimerLabel.BackgroundTransparency = 1
            TimerLabel.Text = "00:00:00"
            TimerLabel.Font = Enum.Font.GothamBold
            TimerLabel.TextSize = 18
            TimerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            TimerLabel.Parent = TimerFrame

            local StartButton = Instance.new("TextButton")
            StartButton.Size = UDim2.new(0, 60, 0, 25)
            StartButton.Position = UDim2.new(0.5, -30, 0, 40)
            StartButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
            StartButton.Text = "Start"
            StartButton.Font = Enum.Font.GothamBold
            StartButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            StartButton.Parent = TimerFrame

            local seconds = Mode == "CountDown" and (HourDuration * 3600 + MinuteDuration * 60 + SecondDuration) or 0
            local running = false
            local function formatTime(total)
                local h = math.floor(total / 3600)
                local m = math.floor((total % 3600) / 60)
                local s = total % 60
                return string.format("%02d:%02d:%02d", h, m, s)
            end

            local function updateText()
                TimerLabel.Text = formatTime(seconds)
            end
            updateText()

            local function tick()
                while running do
                    task.wait(1)
                    if not running then
                        break
                    end
                    if Mode == "CountDown" then
                        seconds = math.max(seconds - 1, 0)
                        if seconds == 0 then
                            running = false
                            StartButton.Text = "Start"
                        end
                    else
                        seconds = seconds + 1
                    end
                    updateText()
                end
            end

            local function toggleTimer()
                running = not running
                StartButton.Text = running and "Stop" or "Start"
                if running then
                    task.spawn(tick)
                end
            end

            StartButton.MouseButton1Click:Connect(toggleTimer)
            if AutoStart then
                toggleTimer()
            end

            return {
                Frame = TimerFrame,
                SetTime = function(_, newSeconds)
                    seconds = newSeconds
                    updateText()
                end,
                Start = function()
                    if not running then
                        toggleTimer()
                    end
                end,
                Stop = function()
                    if running then
                        toggleTimer()
                    end
                end,
            }
        end

        return Tab
    end

