    local Dragging, DragInput, DragStart, StartPos

    TitleLabel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = true
            DragStart = input.Position
            StartPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    Dragging = false
                end
            end)
        end
    end)

    TitleLabel.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            DragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == DragInput and Dragging then
            local delta = input.Position - DragStart
            MainFrame.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y)
        end
    end)

    function window:CreateOpener(Keybind)
        Keybind = Keybind or "LeftControl"
        local toggleTween = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == Enum.KeyCode[Keybind] then
                if MainShadow.Visible then
                    TweenService:Create(MainShadow, toggleTween, {BackgroundTransparency = 1}):Play()
                    task.delay(0.22, function()
                        if MainShadow and MainShadow.Parent then
                            MainShadow.Visible = false
                            MainFrame.Visible = false
                            MainShadow.BackgroundTransparency = 0.72
                        end
                    end)
                else
                    MainShadow.Visible = true
                    MainFrame.Visible = true
                    MainShadow.BackgroundTransparency = 1
                    MainFrame.Position = UDim2.new(0, 5, 0, 25)
                    TweenService:Create(MainShadow, toggleTween, {BackgroundTransparency = 0.72}):Play()
                    TweenService:Create(MainFrame, toggleTween, {Position = UDim2.new(0, 5, 0, 5)}):Play()
                end
            end
        end)
    end

    function window:Notify(settings)
        settings = settings or {}
        local Title = settings.Title or "Notification"
        local Description = settings.Description or "No Description Provided"
        local Duration = settings.Duration or 5
        local CloseButton = settings.CloseButton or false
        local ButtonText = settings.ButtonText or "Close"

        local CoreGui = game:GetService("CoreGui")
        local NotificationFrame = Instance.new("Frame")
        NotificationFrame.Size = UDim2.new(0, 468, 0, 80)
        NotificationFrame.Position = UDim2.new(0.75, 0, 0.75, 0)
        NotificationFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
