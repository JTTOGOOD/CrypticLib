-- Novalib (single-file, loadstring safe)

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- ======================================================
-- Theme
-- ======================================================

local Theme = {
    Background = Color3.fromRGB(18, 18, 18),
    Header = Color3.fromRGB(22, 22, 22),
    Section = Color3.fromRGB(24, 24, 24),
    Border = Color3.fromRGB(40, 40, 40),
    Accent = Color3.fromRGB(120, 180, 255),
    Text = Color3.fromRGB(230, 230, 230),
    SubText = Color3.fromRGB(170, 170, 170),

    Corner = UDim.new(0, 8),
    Tween = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
    TweenFast = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
}

-- ======================================================
-- Kozalib
-- ======================================================

local Kozalib = {}
Kozalib.__index = Kozalib

-- ======================================================
-- Client
-- ======================================================

local Client = {}
Client.__index = Client

function Kozalib:CreateClient(data)
    local self = setmetatable({}, Client)

    self.ToggleKey = data.Toggle or Enum.KeyCode.LeftControl
    self.Windows = {}
    self.Visible = true

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "NovalibUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    self.ScreenGui = ScreenGui

    UIS.InputBegan:Connect(function(i, gpe)
        if gpe then return end
        if i.KeyCode == self.ToggleKey then
            self.Visible = not self.Visible
            for _, win in ipairs(self.Windows) do
                win.Window.Visible = self.Visible
            end
        end
    end)

    return self
end

-- ======================================================
-- TabWindow
-- ======================================================

local TabWindow = {}
TabWindow.__index = TabWindow

function Client:CreateTabWindow(data)
    local selfTab = setmetatable({}, TabWindow)
    selfTab.Client = self

    local Window = Instance.new("Frame")
    Window.Size = data.Size or UDim2.fromOffset(360, 480)
    Window.Position = data.Position or UDim2.fromOffset(100, 100)
    Window.BackgroundColor3 = Theme.Background
    Window.BorderSizePixel = 0
    Window.Active = true
    Window.Draggable = true
    Window.Parent = self.ScreenGui

    Instance.new("UICorner", Window).CornerRadius = Theme.Corner
    Instance.new("UIStroke", Window).Color = Theme.Border

    -- Header
    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1, 0, 0, 46)
    Header.BackgroundColor3 = Theme.Header
    Header.BorderSizePixel = 0
    Header.Parent = Window
    Instance.new("UICorner", Header).CornerRadius = Theme.Corner

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 1, 0)
    Title.BackgroundTransparency = 1
    Title.Text = data.Name
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 18
    Title.TextColor3 = Theme.Text
    Title.TextXAlignment = Center
    Title.Parent = Header

    -- Container
    local Container = Instance.new("Frame")
    Container.Position = UDim2.fromOffset(0, 56)
    Container.Size = UDim2.new(1, 0, 1, -66)
    Container.BackgroundTransparency = 1
    Container.Parent = Window

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 8)
    Layout.Parent = Container

    selfTab.Window = Window
    selfTab.Container = Container

    table.insert(self.Windows, selfTab)
    return selfTab
end

-- ======================================================
-- Button Component
-- ======================================================

function TabWindow:CreateButton(data)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -20, 0, 42)
    Button.BackgroundColor3 = Theme.Section
    Button.Text = data.Name or "Button"
    Button.Font = Enum.Font.GothamSemibold
    Button.TextSize = 14
    Button.TextColor3 = Theme.Text
    Button.AutoButtonColor = false
    Button.Parent = self.Container

    Instance.new("UICorner", Button).CornerRadius = Theme.Corner
    Instance.new("UIStroke", Button).Color = Theme.Border

    Button.MouseEnter:Connect(function()
        TweenService:Create(Button, Theme.TweenFast, {
            BackgroundColor3 = Theme.Accent
        }):Play()
    end)

    Button.MouseLeave:Connect(function()
        TweenService:Create(Button, Theme.TweenFast, {
            BackgroundColor3 = Theme.Section
        }):Play()
    end)

    Button.MouseButton1Click:Connect(function()
        if typeof(data.Function) == "function" then
            data.Function()
        end
    end)

    return Button
end

-- ======================================================
-- Toggle Component
-- ======================================================

function TabWindow:CreateToggle(data)
    local State = data.State or false

    local Holder = Instance.new("Frame")
    Holder.Size = UDim2.new(1, -20, 0, 54)
    Holder.BackgroundColor3 = Theme.Section
    Holder.Parent = self.Container

    Instance.new("UICorner", Holder).CornerRadius = Theme.Corner
    Instance.new("UIStroke", Holder).Color = Theme.Border

    local Title = Instance.new("TextLabel")
    Title.Position = UDim2.fromOffset(12, 6)
    Title.Size = UDim2.new(1, -60, 0, 20)
    Title.BackgroundTransparency = 1
    Title.Text = data.Name or "Toggle"
    Title.Font = Enum.Font.GothamSemibold
    Title.TextSize = 14
    Title.TextColor3 = Theme.Text
    Title.TextXAlignment = Left
    Title.Parent = Holder

    local Desc = Instance.new("TextLabel")
    Desc.Position = UDim2.fromOffset(12, 26)
    Desc.Size = UDim2.new(1, -60, 0, 18)
    Desc.BackgroundTransparency = 1
    Desc.Text = data.Description or ""
    Desc.Font = Enum.Font.Gotham
    Desc.TextSize = 12
    Desc.TextColor3 = Theme.SubText
    Desc.TextXAlignment = Left
    Desc.Parent = Holder

    local ToggleBtn = Instance.new("Frame")
    ToggleBtn.Size = UDim2.fromOffset(36, 18)
    ToggleBtn.Position = UDim2.new(1, -48, 0.5, -9)
    ToggleBtn.BackgroundColor3 = State and Theme.Accent or Theme.Border
    ToggleBtn.Parent = Holder
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)

    local Circle = Instance.new("Frame")
    Circle.Size = UDim2.fromOffset(14, 14)
    Circle.Position = State and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
    Circle.BackgroundColor3 = Theme.Text
    Circle.Parent = ToggleBtn
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

    local function SetState(new)
        State = new

        TweenService:Create(ToggleBtn, Theme.TweenFast, {
            BackgroundColor3 = State and Theme.Accent or Theme.Border
        }):Play()

        TweenService:Create(Circle, Theme.TweenFast, {
            Position = State and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
        }):Play()

        if typeof(data.Function) == "function" then
            data.Function(State)
        end
    end

    Holder.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            SetState(not State)
        end
    end)

    return Holder
end

-- ======================================================
-- Return
-- ======================================================

return Kozalib
