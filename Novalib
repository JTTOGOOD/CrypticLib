-- Novalib (single-file, loadstring safe)

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- ======================================================
-- Theme
-- ======================================================

local Theme = {
    Background = Color3.fromRGB(18, 18, 18),
    Header = Color3.fromRGB(22, 22, 22),
    Module = Color3.fromRGB(26, 26, 26),
    Border = Color3.fromRGB(40, 40, 40),
    Text = Color3.fromRGB(230, 230, 230),

    Corner = UDim.new(0, 6),
    Tween = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
}

-- ======================================================
-- Kozalib
-- ======================================================

local Kozalib = {}
Kozalib.__index = Kozalib

-- ======================================================
-- Client
-- ======================================================

local Client = {}
Client.__index = Client

function Kozalib:CreateClient(data)
    local self = setmetatable({}, Client)

    self.ToggleKey = data.Toggle or Enum.KeyCode.LeftControl
    self.Visible = true
    self.Windows = {}

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "KozalibUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

    self.ScreenGui = ScreenGui

    UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == self.ToggleKey then
            self:SetVisible(not self.Visible)
        end
    end)

    return self
end

function Client:SetVisible(state)
    self.Visible = state

    for _, win in ipairs(self.Windows) do
        local frame = win.Window
        frame.Visible = true

        TweenService:Create(
            frame,
            Theme.Tween,
            {BackgroundTransparency = state and 0 or 1}
        ):Play()

        task.delay(0.25, function()
            frame.Visible = state
        end)
    end
end

-- ======================================================
-- TabWindow
-- ======================================================

local TabWindow = {}
TabWindow.__index = TabWindow

function Client:CreateTabWindow(data)
    local selfTab = setmetatable({}, TabWindow)
    selfTab.Client = self

    -- Window
    local Window = Instance.new("Frame")
    Window.Name = data.Name .. "_Window"
    Window.Size = data.Size or UDim2.fromOffset(345, 480)
    Window.Position = data.Position or UDim2.fromOffset(100, 100)
    Window.BackgroundColor3 = Theme.Background
    Window.BorderSizePixel = 0
    Window.Active = true
    Window.Draggable = true
    Window.Parent = self.ScreenGui

    Instance.new("UICorner", Window).CornerRadius = Theme.Corner
    Instance.new("UIStroke", Window).Color = Theme.Border

    -- Header
    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1, 0, 0, 42)
    Header.BackgroundColor3 = Theme.Header
    Header.BorderSizePixel = 0
    Header.Parent = Window

    Instance.new("UICorner", Header).CornerRadius = Theme.Corner

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 1, 0)
    Title.BackgroundTransparency = 1
    Title.Text = data.Name
    Title.TextColor3 = Theme.Text
    Title.TextSize = 18
    Title.Font = Enum.Font.GothamSemibold
    Title.TextXAlignment = Enum.TextXAlignment.Center
    Title.TextYAlignment = Enum.TextYAlignment.Center
    Title.Parent = Header

    -- Container (prevents overlap)
    local Container = Instance.new("Frame")
    Container.Position = UDim2.fromOffset(10, 52)
    Container.Size = UDim2.new(1, -20, 1, -62)
    Container.BackgroundTransparency = 1
    Container.Parent = Window

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 8)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Layout.Parent = Container

    -- Fade in
    Window.BackgroundTransparency = 1
    TweenService:Create(Window, Theme.Tween, {
        BackgroundTransparency = 0
    }):Play()

    selfTab.Window = Window
    selfTab.Container = Container

    table.insert(self.Windows, selfTab)
    return selfTab
end

-- ======================================================
-- Button Component
-- ======================================================

function TabWindow:CreateButton(data)
    local Button = {}

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 0, 44)
    Frame.BackgroundColor3 = Theme.Module
    Frame.BorderSizePixel = 0
    Frame.Parent = self.Container

    Instance.new("UICorner", Frame).CornerRadius = Theme.Corner

    local Stroke = Instance.new("UIStroke", Frame)
    Stroke.Color = Theme.Border
    Stroke.Transparency = 0.35

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -16, 1, 0)
    Label.Position = UDim2.fromOffset(16, 0)
    Label.BackgroundTransparency = 1
    Label.Text = data.Name or "Button"
    Label.TextColor3 = Theme.Text
    Label.TextSize = 16
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.TextYAlignment = Enum.TextYAlignment.Center
    Label.Parent = Frame

    local Click = Instance.new("TextButton")
    Click.Size = UDim2.fromScale(1, 1)
    Click.BackgroundTransparency = 1
    Click.Text = ""
    Click.Parent = Frame

    -- Hover
    Click.MouseEnter:Connect(function()
        TweenService:Create(Frame, Theme.Tween, {
            BackgroundColor3 = Theme.Header
        }):Play()
    end)

    Click.MouseLeave:Connect(function()
        TweenService:Create(Frame, Theme.Tween, {
            BackgroundColor3 = Theme.Module
        }):Play()
    end)

    -- Click animation + function
    Click.MouseButton1Click:Connect(function()
        TweenService:Create(Frame, TweenInfo.new(0.1), {
            Size = UDim2.new(1, -6, 0, 40)
        }):Play()

        task.delay(0.1, function()
            TweenService:Create(Frame, Theme.Tween, {
                Size = UDim2.new(1, 0, 0, 44)
            }):Play()
        end)

        if typeof(data.Function) == "function" then
            task.spawn(data.Function)
        end
    end)

    Button.Frame = Frame
    return Button
end

-- ======================================================
-- RETURN
-- ======================================================

return Kozalib
