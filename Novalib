-- Client.lua
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Theme = require(script.Theme)

local Client = {}
Client.__index = Client

function Client.new(data)
    local self = setmetatable({}, Client)

    self.ToggleKey = data.Toggle or Enum.KeyCode.LeftControl
    self.Visible = true
    self.Windows = {}

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "Kozalib"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = game.Players.LocalPlayer.PlayerGui

    self.ScreenGui = ScreenGui

    UIS.InputBegan:Connect(function(i, gpe)
        if gpe then return end
        if i.KeyCode == self.ToggleKey then
            self:SetVisible(not self.Visible)
        end
    end)

    return self
end

function Client:SetVisible(state)
    self.Visible = state

    for _, window in ipairs(self.Windows) do
        local frame = window.Window
        frame.Visible = true

        TweenService:Create(
            frame,
            Theme.TweenSmooth,
            {BackgroundTransparency = state and 0 or 1}
        ):Play()

        task.delay(0.25, function()
            frame.Visible = state
        end)

        window:HideOverlays()
    end
end

function Client:CreateTabWindow(data)
    local TabWindow = require(script.TabWindow)
    local win = TabWindow.new(self, data)
    table.insert(self.Windows, win)
    return win
end

return Client

-- TabWindow.lua
local Theme = require(script.Parent.Theme)
local TabWindow = {}
TabWindow.__index = TabWindow

function TabWindow.new(Client, data)
    local self = setmetatable({}, TabWindow)
    self.Client = Client
    self.Overlays = {}

    local Window = Instance.new("Frame")
    Window.Size = data.Size or UDim2.fromOffset(230, 320)
    Window.Position = data.Position or UDim2.fromOffset(100, 100)
    Window.BackgroundColor3 = Theme.Background
    Window.Parent = Client.ScreenGui
    Window.Active = true
    Window.Draggable = true

    Instance.new("UICorner", Window).CornerRadius = Theme.Corner
    Instance.new("UIStroke", Window).Color = Theme.Border

    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1, 0, 0, 30)
    Header.BackgroundColor3 = Theme.Header
    Header.Parent = Window

    Instance.new("UICorner", Header).CornerRadius = Theme.Corner

    local Title = Instance.new("TextLabel")
    Title.Text = data.Name
    Title.Size = UDim2.new(1, -12, 1, 0)
    Title.Position = UDim2.fromOffset(12, 0)
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.TextColor3 = Theme.Text
    Title.Parent = Header

    local Container = Instance.new("ScrollingFrame")
    Container.Position = UDim2.fromOffset(0, 30)
    Container.Size = UDim2.new(1, 0, 1, -30)
    Container.ScrollBarImageTransparency = 0.5
    Container.BackgroundTransparency = 1
    Container.Parent = Window

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 6)
    Layout.Parent = Container

    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Container.CanvasSize = UDim2.fromOffset(0, Layout.AbsoluteContentSize.Y + 6)
    end)

    self.Window = Window
    self.Container = Container
    return self
end

function TabWindow:HideOverlays()
    for _, o in ipairs(self.Overlays) do
        o.Visible = false
    end
end

function TabWindow:CreateButton(data)
    local Components = require(script.Components)
    return Components.CreateButton(self, data)
end

return TabWindow
