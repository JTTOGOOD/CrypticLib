-- Novalib (single-file, loadstring safe)

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

-- ======================================================
-- Theme
-- ======================================================

local Theme = {
    Background = Color3.fromRGB(18, 18, 18),
    Header = Color3.fromRGB(22, 22, 22),
    Module = Color3.fromRGB(26, 26, 26),
    Border = Color3.fromRGB(40, 40, 40),
    Accent = Color3.fromRGB(120, 180, 255),
    Text = Color3.fromRGB(230, 230, 230),
    SubText = Color3.fromRGB(160, 160, 160),

    Corner = UDim.new(0, 6),
    Tween = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
}

-- ======================================================
-- Kozalib
-- ======================================================

local Kozalib = {}
Kozalib.__index = Kozalib

-- ======================================================
-- Client
-- ======================================================

local Client = {}
Client.__index = Client

function Kozalib:CreateClient(data)
    local self = setmetatable({}, Client)

    self.ToggleKey = data.Toggle or Enum.KeyCode.LeftControl
    self.Visible = true
    self.Windows = {}

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "KozalibUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    self.ScreenGui = ScreenGui

    -- Welcome Panel
    local Welcome = Instance.new("Frame")
    Welcome.Size = UDim2.fromOffset(260, 70)
    Welcome.Position = UDim2.new(1, -270, 1, -80)
    Welcome.BackgroundColor3 = Theme.Background
    Welcome.Parent = ScreenGui

    Instance.new("UICorner", Welcome).CornerRadius = Theme.Corner
    Instance.new("UIStroke", Welcome).Color = Theme.Border

    local Avatar = Instance.new("ImageLabel")
    Avatar.Size = UDim2.fromOffset(48, 48)
    Avatar.Position = UDim2.fromOffset(12, 11)
    Avatar.BackgroundTransparency = 1
    Avatar.Image = Players:GetUserThumbnailAsync(
        LocalPlayer.UserId,
        Enum.ThumbnailType.HeadShot,
        Enum.ThumbnailSize.Size420x420
    )
    Avatar.Parent = Welcome
    Instance.new("UICorner", Avatar).CornerRadius = UDim.new(1, 0)

    local WelcomeText = Instance.new("TextLabel")
    WelcomeText.Position = UDim2.fromOffset(72, 0)
    WelcomeText.Size = UDim2.new(1, -72, 1, 0)
    WelcomeText.BackgroundTransparency = 1
    WelcomeText.Text = "Welcome " .. LocalPlayer.Name
    WelcomeText.TextColor3 = Theme.Text
    WelcomeText.TextSize = 16
    WelcomeText.Font = Enum.Font.GothamSemibold
    WelcomeText.TextXAlignment = Enum.TextXAlignment.Left
    WelcomeText.Parent = Welcome

    self.Welcome = Welcome

    UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == self.ToggleKey then
            self:SetVisible(not self.Visible)
        end
    end)

    return self
end

function Client:SetVisible(state)
    self.Visible = state

    for _, win in ipairs(self.Windows) do
        win.Window.Visible = state
    end

    self.Welcome.Visible = state
end

-- ======================================================
-- TabWindow
-- ======================================================

local TabWindow = {}
TabWindow.__index = TabWindow

function Client:CreateTabWindow(data)
    local selfTab = setmetatable({}, TabWindow)
    selfTab.Client = self

    local Window = Instance.new("Frame")
    Window.Size = data.Size or UDim2.fromOffset(345, 480)
    Window.Position = data.Position or UDim2.fromOffset(100, 100)
    Window.BackgroundColor3 = Theme.Background
    Window.Active = true
    Window.Draggable = true
    Window.Parent = self.ScreenGui

    Instance.new("UICorner", Window).CornerRadius = Theme.Corner
    Instance.new("UIStroke", Window).Color = Theme.Border

    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1, 0, 0, 42)
    Header.BackgroundColor3 = Theme.Header
    Header.Parent = Window
    Instance.new("UICorner", Header).CornerRadius = Theme.Corner

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.fromScale(1, 1)
    Title.BackgroundTransparency = 1
    Title.Text = data.Name
    Title.TextColor3 = Theme.Text
    Title.TextSize = 18
    Title.Font = Enum.Font.GothamSemibold
    Title.Parent = Header

    local Container = Instance.new("Frame")
    Container.Position = UDim2.fromOffset(10, 52)
    Container.Size = UDim2.new(1, -20, 1, -62)
    Container.BackgroundTransparency = 1
    Container.Parent = Window

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 8)
    Layout.Parent = Container

    selfTab.Window = Window
    selfTab.Container = Container

    table.insert(self.Windows, selfTab)
    return selfTab
end

-- ======================================================
-- Button Component (FIXED)
-- ======================================================

function TabWindow:CreateButton(data)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 0, 44)
    Frame.BackgroundColor3 = Theme.Module
    Frame.Parent = self.Container

    Instance.new("UICorner", Frame).CornerRadius = Theme.Corner
    Instance.new("UIStroke", Frame).Color = Theme.Border

    local Label = Instance.new("TextLabel")
    Label.Position = UDim2.fromOffset(14, 0)
    Label.Size = UDim2.new(1, -14, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = data.Name or "Button"
    Label.TextColor3 = Theme.Text
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = 16
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame

    local Click = Instance.new("TextButton")
    Click.Size = UDim2.fromScale(1, 1)
    Click.BackgroundTransparency = 1
    Click.Text = ""
    Click.Parent = Frame

    Click.MouseButton1Click:Connect(function()
        if typeof(data.Function) == "function" then
            task.spawn(data.Function)
        end
    end)
end

-- ======================================================
-- Toggle Component
-- ======================================================

function TabWindow:CreateToggle(data)
    local State = data.State or false

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 0, 54)
    Frame.BackgroundColor3 = Theme.Module
    Frame.Parent = self.Container

    Instance.new("UICorner", Frame).CornerRadius = Theme.Corner
    Instance.new("UIStroke", Frame).Color = Theme.Border

    local Title = Instance.new("TextLabel")
    Title.Position = UDim2.fromOffset(12, 6)
    Title.Size = UDim2.new(1, -80, 0, 20)
    Title.BackgroundTransparency = 1
    Title.Text = data.Name
    Title.TextColor3 = Theme.Text
    Title.Font = Enum.Font.GothamMedium
    Title.TextSize = 15
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Frame

    local Desc = Instance.new("TextLabel")
    Desc.Position = UDim2.fromOffset(12, 26)
    Desc.Size = UDim2.new(1, -80, 0, 18)
    Desc.BackgroundTransparency = 1
    Desc.Text = data.Description or ""
    Desc.TextColor3 = Theme.SubText
    Desc.TextSize = 13
    Desc.Font = Enum.Font.Gotham
    Desc.TextXAlignment = Enum.TextXAlignment.Left
    Desc.Parent = Frame

    local Switch = Instance.new("Frame")
    Switch.Size = UDim2.fromOffset(36, 18)
    Switch.Position = UDim2.new(1, -48, 0.5, -9)
    Switch.BackgroundColor3 = State and Theme.Accent or Theme.Border
    Switch.Parent = Frame
    Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.fromOffset(14, 14)
    Knob.Position = State and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
    Knob.BackgroundColor3 = Color3.new(1, 1, 1)
    Knob.Parent = Switch
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local Click = Instance.new("TextButton")
    Click.Size = UDim2.fromScale(1, 1)
    Click.BackgroundTransparency = 1
    Click.Text = ""
    Click.Parent = Frame

    Click.MouseButton1Click:Connect(function()
        State = not State

        TweenService:Create(Switch, Theme.Tween, {
            BackgroundColor3 = State and Theme.Accent or Theme.Border
        }):Play()

        TweenService:Create(Knob, Theme.Tween, {
            Position = State and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
        }):Play()

        if typeof(data.Function) == "function" then
            task.spawn(data.Function, State)
        end
    end)
end

-- ======================================================
-- RETURN
-- ======================================================

return Kozalib
